# Check if string contains balanced parentheses: "((()))"
text = "((()))"
count = 0
for i in text:
    if i == "(":
        count +=1
    elif i == ")":
        count -= 1
    if count <0:
        break
if count == 0:
    print("Balanced")
else:
    print("Not ok")


# Find the longest common substring between "programming" and "grammar"
s1 = "programming"
s2 = "grammar"

longest = ""

for i in range(len(s1)):
    for j in range(i + 1, len(s1) + 1):
        sub = s1[i:j]
        if sub in s2 and len(sub) > len(longest):
            longest = sub

print(longest)

